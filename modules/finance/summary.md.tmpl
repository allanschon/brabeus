finance:
{{- range first 2 (.Kind "target")}}
- target: {{index .Fields "statement"}} by {{index .Fields "by"}}
{{- end}}
{{- range first 2 (.Kind "obligation")}}
- owed: {{index .Fields "statement"}} due {{index .Fields "due"}}
{{- end}}
{{- range first 1 (.Kind "metric")}}
- {{index .Fields "statement"}}: {{index .Fields "value"}} ({{index .Fields "measured"}})
{{- end}}
