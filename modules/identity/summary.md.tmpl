{{- /* The summary renders value, fact and belief. Register and preference are instructions, delivered in full beside the block (spec §7). */ -}}
identity:
{{- range first 2 (.Kind "value")}}
- value: {{index .Fields "statement"}}{{.Mark}}
{{- end}}
{{- range first 1 (.Kind "fact")}}
- {{index .Fields "statement"}}{{.Mark}}
{{- end}}
{{- range first 1 (.Kind "belief")}}
- believes: {{index .Fields "statement"}}{{.Mark}}
{{- end}}
