{{- /* A ratified memory/preference crosses in with no statement field (spec §7); it renders from its description instead. */ -}}
identity:
{{- range first 3 (.Kind "value")}}
- value: {{index .Fields "statement"}}{{if .Reviewed.IsZero}} (unconfirmed){{end}}
{{- end}}
{{- range first 2 (.Kind "preference")}}
- preference: {{or (index .Fields "statement") .Description}}
{{- end}}
{{- range first 1 (.Kind "fact")}}
- {{index .Fields "statement"}}
{{- end}}
{{- range first 1 (.Kind "belief")}}
- believes: {{index .Fields "statement"}}
{{- end}}
