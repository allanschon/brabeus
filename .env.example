# Every BRABEUS_* variable the kernel reads, with its default or "# required".
# Copy this file to .env and fill in at least BRABEUS_REPO.

# The private repository the kernel writes your record to. Required — no default.
BRABEUS_REPO=ssh://git@example.org/you/record.git

# A second, read-only repository mounted alongside the record, so a memory can
# point into it without copying. Empty (the default) disables it.
BRABEUS_MIRROR_REPO=

# --- Modules ---
# Comma-separated names of the modules to enable; each must have a
# module.json under BRABEUS_MODULES_DIR. The kernel refuses to start on a
# manifest it does not understand or a set whose budgets overflow the block.
BRABEUS_MODULES=memory
BRABEUS_MODULES_DIR=/etc/brabeus/modules
# Set to 1 for ONE start to retag every pre-module record (type: → module:
# and kind:, through the memory module's legacy_types). Idempotent, but unset
# it afterwards: a migration should be a thing you did, not a thing restarts do.
BRABEUS_MIGRATE=

# --- Listening and identity ---
BRABEUS_LISTEN=127.0.0.1:8082
# tailscale (default) or token. tailscale resolves the caller from
# X-Forwarded-For via tailscaled's LocalAPI; token maps a bearer token to a
# machine name (BRABEUS_TOKENS below).
BRABEUS_IDENTITY_MODE=tailscale
# Peers whose X-Forwarded-For is believed. Under Docker, this must name the
# bridge gateway the published port arrives from (e.g. 172.17.0.1), not just
# loopback — the server refuses to start otherwise.
BRABEUS_TRUSTED_PROXIES=127.0.0.0/8,::1/128
BRABEUS_TAILSCALE_SOCK=/var/run/tailscale/tailscaled.sock
# Only used when BRABEUS_IDENTITY_MODE=token: tok=machine,tok2=machine2,...
BRABEUS_TOKENS=

# Machine names (as the identity mode resolves them) that are NOT the person's
# own sessions: a dashboard, another agent, an exchange with another system.
# A consumer sees only modules with audience: any and never writes. Empty means
# every resolved caller is the person's own session; a caller the identity mode
# cannot resolve at all is refused outright, before any tool runs (spec §11).
BRABEUS_CONSUMERS=

# --- Auth ---
# none (default) or bearer, with BRABEUS_AUTH_TOKEN.
BRABEUS_AUTH_MODE=none
BRABEUS_AUTH_TOKEN=

# --- Storage paths (defaults match the Docker image) ---
BRABEUS_DIR=/var/lib/brabeus/memory
BRABEUS_MIRROR_DIR=/var/lib/brabeus/projects
BRABEUS_SSH_KEY=/etc/brabeus/deploy_key
BRABEUS_MIRROR_SSH_KEY=/etc/brabeus/projects_key
BRABEUS_KNOWN_HOSTS=/var/lib/brabeus/known_hosts
BRABEUS_BRANCH=main

# --- Commit identity ---
# Not the operator's — so history distinguishes machine writes from human ones.
BRABEUS_COMMIT_NAME=brabeus
BRABEUS_COMMIT_EMAIL=brabeus@localhost

# --- The dense (meaning-based) search leg ---
# Empty (the default) disables it: the kernel stays keyword-only.
BRABEUS_EMBED_URL=
BRABEUS_EMBED_MODEL=embeddinggemma

# --- Claim evidence (spec §8.1) ---
# The task tracker a tracker claim counts in: vikunja, or empty for none.
BRABEUS_TRACKER=
# The tracker's base URL; required when BRABEUS_TRACKER is set.
BRABEUS_TRACKER_URL=
# An API token that can read the person's tasks.
BRABEUS_TRACKER_TOKEN=
# The git forge a forge claim counts in: gitea, github, or empty for none.
BRABEUS_FORGE=
# The forge's base URL; required for gitea, https://api.github.com for github.
BRABEUS_FORGE_URL=
# A read-only token for the repositories claims name.
BRABEUS_FORGE_TOKEN=
# The owner a bare repo: name resolves against; empty makes such a claim no-evidence.
BRABEUS_FORGE_OWNER=
