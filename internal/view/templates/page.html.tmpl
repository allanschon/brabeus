{{define "page"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · Brabeus</title>
<link rel="stylesheet" href="/view/static/view.css">
</head>
<body>
{{template "sprite"}}
<div class="page">
{{template "nav" .}}
{{.Main}}
</div>
</body>
</html>
{{end}}

