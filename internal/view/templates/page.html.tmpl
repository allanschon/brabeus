{{end}}

{{define "nav"}}<nav class="site-nav" aria-label="Record">
  <a class="site-nav__brand" href="/view/">Brabeus <span class="site-nav__sub">view</span></a>
  <div class="site-nav__groups">
    <ul class="site-nav__group">
      <li><a class="site-nav__link" href="/view/"{{if .Home}} aria-current="page"{{end}}>Home</a></li>
      {{- range .Records}}
      <li><a class="site-nav__link" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
      {{- end}}
    </ul>
    {{- if .Notes}}
    <ul class="site-nav__group site-nav__group--notes" aria-label="Model's notes">
      <li class="site-nav__label" aria-hidden="true">Model's notes</li>
      {{- range .Notes}}
      <li><a class="site-nav__link" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>
      {{- end}}
    </ul>
    {{- end}}
  </div>
</nav>{{end}}
